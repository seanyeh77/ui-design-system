{
  "name": "@seanyeh77/ui",
  "version": "0.2.0",
  "description": "SeanYeh's design system: typed React components on Base UI, styled with design tokens.",
  "license": "MIT",
  "author": "Hsiu-An Yeh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanyeh77/ui-design-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://seanyeh77.github.io/ui-design-system/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./bundle.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./umd": "./dist/bundle.js",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown && node scripts/postbuild.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@seanyeh77/tokens": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7"
  }
}
