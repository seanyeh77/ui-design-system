{
  "name": "@seanyeh77/ui",
  "version": "0.45.0",
  "description": "SeanYeh's design system: typed React components on Base UI, styled with design tokens.",
  "license": "MIT",
  "author": "Hsiu-An Yeh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanyeh77/ui-design-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://seanyeh77.github.io/ui-design-system/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format-entry.d.ts",
      "default": "./dist/format-entry.js"
    },
    "./styles.css": "./dist/styles.css",
    "./css/*": "./dist/css/*",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts-latin.css": "./dist/fonts-latin.css",
    "./fonts-tc.css": "./dist/fonts-tc.css",
    "./bundle.js": "./dist/bundle.js",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/bundle.js.map",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/theme-defaults.ts && tsdown && node scripts/postbuild.ts",
    "typecheck": "tsc -p .",
    "test": "node scripts/check-css-tokens.ts && node scripts/theme-defaults.ts --check && node scripts/check-jsdoc.ts && vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@storybook/react": "^10.6.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "jsdom": "^31.0.1",
    "playwright": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@seanyeh77/tokens": "workspace:^"
  }
}
